APP_NAME=YourApp
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001
APP_PORT=8001

# Docker/Sail user settings (use 1000 for Linux, your UID for macOS)
WWWGROUP=1000
WWWUSER=1000

APP_FRONTEND_URL=http://localhost:3000
SPA_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8001

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Media Storage: 'public' for local dev, 's3' for production (DigitalOcean Spaces)
MEDIA_DISK=public

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail Configuration
# For local dev: use "log" mailer (emails go to storage/logs)
# For production: use "smtp" with Gmail (see below)
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Gmail SMTP Configuration (for production)
# 1. Enable 2-Step Verification on your Google account
# 2. Go to Google Account > Security > App passwords
# 3. Generate an app password for "Mail" on "Other (Custom name)"
# 4. Use these settings:
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password-here
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=your-email@gmail.com
# MAIL_FROM_NAME="${APP_NAME}"

# DigitalOcean Spaces (S3-compatible)
# For production, set MEDIA_DISK=s3 and configure these:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=nyc3
AWS_BUCKET=your-space-name
AWS_ENDPOINT=https://nyc3.digitaloceanspaces.com
AWS_URL=https://your-space-name.nyc3.cdn.digitaloceanspaces.com
AWS_USE_PATH_STYLE_ENDPOINT=false

# Stripe Integration — three accounts (money routed per event via events.stripe_account)
# Cuenta 1: Cafeteria / flujo diario. Falls back to legacy STRIPE_* vars if unset.
STRIPE_CAFETERIA_KEY=pk_test_xxx
STRIPE_CAFETERIA_SECRET=sk_test_xxx
STRIPE_CAFETERIA_WEBHOOK_SECRET=whsec_xxx
# Cuenta 2: Rifa (aislada)
STRIPE_RIFA_KEY=
STRIPE_RIFA_SECRET=
STRIPE_RIFA_WEBHOOK_SECRET=
# Cuenta 3: Eventos (primera comunion, graduaciones, paseos)
STRIPE_EVENTOS_KEY=
STRIPE_EVENTOS_SECRET=
STRIPE_EVENTOS_WEBHOOK_SECRET=
# Account used when an event has none set
STRIPE_DEFAULT_ACCOUNT=cafeteria
# Legacy vars (kept as fallback for cafeteria)
STRIPE_KEY=pk_test_xxx
STRIPE_SECRET=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=${APP_URL}/api/auth/google/callback

# Mailgun (optional)
# MAILGUN_DOMAIN=
# MAILGUN_SECRET=
